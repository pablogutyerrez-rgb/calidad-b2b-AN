PORT=5174
# Optional canonical browser origin, e.g. https://your-custom-domain.com
# Railway uses RAILWAY_PUBLIC_DOMAIN automatically when this is empty.
PUBLIC_ORIGIN=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
DATABASE_BACKEND=postgres
POSTGRES_PHASES=
PG_POOL_MAX=10
ADMIN_USERNAME=
ADMIN_NAME=
ADMIN_PASSWORD=
FIREBASE_URL=
FIREBASE_DATABASE_SECRET=
SPREADSHEET_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_STORAGE_BUCKET=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Configure GOOGLE_CREDENTIALS_JSON in the hosting secret manager if needed.
